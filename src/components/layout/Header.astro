---
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  navigation: Array<{ label: string; href: string }>;
}

const { navigation } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface-50/80 dark:bg-surface-950/80 backdrop-blur-md border-b border-surface-200 dark:border-surface-800">
  <nav class="container" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href={import.meta.env.BASE_URL} class="text-xl font-bold text-surface-900 dark:text-surface-50" >
        TE
      </a>
      
      <div class="hidden lg:flex items-center gap-8">
        {navigation.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
          >
            {item.label}
          </a>
        ))}
        <ThemeToggle />
      </div>
      
      <div class="lg:hidden flex items-center gap-4">
        <ThemeToggle />
        <button
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          type="button"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>
    
    <div id="mobile-menu" class="lg:hidden hidden py-4 border-t border-surface-200 dark:border-surface-800" role="navigation" aria-label="Mobile navigation">
      <div class="flex flex-col gap-4">
        {navigation.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 text-base font-medium text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!expanded).toString());
      menu.classList.toggle('hidden');
      
      const icon = toggle.querySelector('svg');
      if (icon) {
        icon.innerHTML = expanded
          ? '<line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />'
          : '<line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />';
      }
    });
    
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        const icon = toggle.querySelector('svg');
        if (icon) {
          icon.innerHTML = '<line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />';
        }
      });
    });
  }
</script>

<style>
  :host {
    display: block;
  }
</style>