---
---

<button
  id="theme-toggle"
  class="btn-ghost p-2 rounded-lg"
  aria-label="Toggle theme"
  aria-pressed="false"
  type="button"
>
  <span class="theme-icon-light" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
  </span>
  <span class="theme-icon-dark hidden" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </span>
</button>

<script>
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  const lightIcon = toggle?.querySelector('.theme-icon-light');
  const darkIcon = toggle?.querySelector('.theme-icon-dark');

  if (toggle && lightIcon && darkIcon) {

  function updateIcons(theme: string) {
    const light = lightIcon as Element;
    const dark = darkIcon as Element;
    const btn = toggle as HTMLElement;
    if (theme === 'dark') {
      light.classList.add('hidden');
      dark.classList.remove('hidden');
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', 'Switch to light mode');
    } else {
      light.classList.remove('hidden');
      dark.classList.add('hidden');
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-label', 'Switch to dark mode');
    }
  }
  
  function getTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem('portfolio-theme');
    if (stored) return stored as 'light' | 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  
  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('portfolio-theme', theme);
    updateIcons(theme);
  }
  
  toggle.addEventListener('click', () => {
    const current = getTheme();
    const next = current === 'light' ? 'dark' : 'light';
    applyTheme(next);
  });
  
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    const stored = localStorage.getItem('portfolio-theme');
    if (!stored) {
      applyTheme(e.matches ? 'dark' : 'light');
    }
  });
  
  applyTheme(getTheme());
  }
</script>

<style>
  :host {
    display: inline-flex;
  }
  
  button {
    transition: all 0.2s ease;
  }
  
  button:hover {
    background-color: var(--color-surface-100);
  }
  
  [data-theme="dark"] button:hover {
    background-color: var(--color-surface-800);
  }
</style>