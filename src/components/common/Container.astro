---
interface Props {
  children: any;
  class?: string;
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '7xl' | 'full';
}

const { children, class: className = '', maxWidth = '7xl' } = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  '2xl': 'max-w-[96rem]',
  '7xl': 'max-w-7xl',
  full: 'max-w-full',
};
---

<div class={`mx-auto px-4 sm:px-6 lg:px-8 ${maxWidthClasses[maxWidth]} ${className}`}>
  <slot />
</div>

<style>
  :host {
    display: block;
  }
</style>