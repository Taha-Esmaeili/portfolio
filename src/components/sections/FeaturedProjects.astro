---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

// Projects come from the src/content/projects collection so they can be
// managed from the admin panel. All projects are shown, newest first, with a
// "Featured" badge on cards flagged `featured`.
const allProjects = await getCollection('projects');
const projects = allProjects
  .map(({ data }) => data)
  .sort((a, b) => b.startDate.localeCompare(a.startDate));
---
<Section id="projects" title="Projects">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {projects.map((project) => (
      <article class="card p-6 group flex flex-col hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 hover:shadow-soft-lg hover:-translate-y-1">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 border border-primary-100 dark:border-primary-800">
              {project.domain ?? project.category}
            </span>
            {project.featured && (
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-100 dark:border-amber-800">
                <Icon name="tabler:star-filled" class="w-3.5 h-3.5" aria-hidden="true" />
                Featured
              </span>
            )}
          </div>
          {!project.liveUrl && !project.codeUrl && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-surface-100/80 dark:bg-surface-800/80 border border-surface-200 dark:border-surface-700 text-surface-600 dark:text-surface-400">
              <Icon name="tabler:lock" class="w-3.5 h-3.5" aria-hidden="true" />
              Enterprise / Private Architecture
            </span>
          )}
        </div>

        <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-50 leading-snug">{project.title}</h3>

        <p class="text-sm text-surface-600 dark:text-surface-400 mt-3 leading-relaxed">{project.description}</p>

        {project.highlights && project.highlights.length > 0 && (
          <ul class="mt-4 space-y-2.5 flex-1" role="list" aria-label={`${project.title} highlights`}>
            {project.highlights.map((point) => (
              <li class="flex gap-2.5 text-sm text-surface-600 dark:text-surface-400 leading-relaxed" role="listitem">
                <Icon name="tabler:check" class="w-4 h-4 flex-shrink-0 text-primary-500 dark:text-primary-400 mt-0.5" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )}

        <ul class="mt-5 flex flex-wrap gap-2" role="list" aria-label="Technologies">
          {project.techStack.map((tag) => (
            <li
              class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-100/80 dark:bg-surface-800/80 border border-surface-200 dark:border-surface-700 text-surface-700 dark:text-surface-300"
              role="listitem"
            >
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</Section>