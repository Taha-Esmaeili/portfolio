---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';
import categoryMeta from '../../content/skill-categories.json';

type CategoryMeta = Record<string, { label?: string; icon?: string }>;

interface Props {
  skills: Array<{
    id: string;
    name: string;
    category: string;
    proficiency: number;
    yearsExperience: number;
    description?: string;
    icon?: string;
    relatedProjects?: string[];
  }>;
}

const { skills } = Astro.props;

// Category display names/icons are managed from the admin panel and stored
// in src/content/skill-categories.json. Categories shown are derived from
// the skills that actually exist, so hiding/removing skills prunes empty
// categories automatically.
const meta = categoryMeta as CategoryMeta;
const categoryOrder = [...new Set(skills.map((s) => s.category))];
const categories = categoryOrder.map((key) => ({
  key,
  label: meta[key]?.label ?? key,
  icon: meta[key]?.icon ?? 'mdi:tag',
}));

const categorySkills = (key: string) => skills.filter((s) => s.category === key);
---

<Section id="skills" title="Skills" subtitle="Technologies and tools I work with regularly, organized by category.">
  <div class="space-y-12 lg:space-y-16">
    {categories.map((cat, catIndex) => (
      <div class="animate-in" style={`animation-delay: ${catIndex * 100}ms`}>
        <div class="flex items-center gap-3 mb-6">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400">
            <Icon name={cat.icon} class="w-5 h-5" aria-hidden="true" />
          </span>
          <h3 class="text-xl font-semibold text-surface-900 dark:text-surface-50">{cat.label}</h3>
          <span class="ml-2 text-sm text-surface-400 dark:text-surface-500">{categorySkills(cat.key).length}</span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {categorySkills(cat.key).map((skill, skillIndex) => (
            <article
              class="card p-5 group hover:border-primary-300 dark:hover:border-primary-700 animate-in"
              style={`animation-delay: ${(catIndex * 100) + (skillIndex * 50)}ms`}
            >
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                  <Icon name={skill.icon || 'mdi:help-circle'} class="w-6 h-6 text-primary-600 dark:text-primary-400" aria-hidden="true" />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="font-medium text-surface-900 dark:text-surface-50 truncate">{skill.name}</h4>
                  {skill.description && (
                    <p class="text-xs text-surface-600 dark:text-surface-400 mt-0.5 leading-snug">{skill.description}</p>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  :host {
    display: block;
  }
</style>
