---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';

interface Capability {
  key: string;
  title: string;
  description: string;
  icon: string;
  tags: string[];
}

// Capability-driven architecture: exactly 5 domain cards, no self-ratings
// or duration counters. Content is authored here; individual skill files
// in src/content/skills/ are legacy data kept for reference.
const capabilities: Capability[] = [
  {
    key: 'nlp-genai',
    title: 'NLP & Generative AI',
    description: 'Architecting modern language models, semantic retrieval, and agentic workflows.',
    icon: 'tabler:brain',
    tags: [
      'Large Language Models (LLMs)',
      'Transformers',
      'RAG Architecture',
      'PEFT / LoRA Fine-Tuning',
      'LangChain',
      'LangGraph',
      'Vector Databases',
      'Semantic Text Similarity (STS)',
      'Persian NLP',
    ],
  },
  {
    key: 'classical-ml',
    title: 'Predictive Modeling & Classical ML',
    description: 'End-to-end tabular pipelines, predictive modeling, and robust validation.',
    icon: 'tabler:chart-bar',
    tags: [
      'Scikit-Learn',
      'XGBoost',
      'LightGBM',
      'Random Forest',
      'Feature Engineering',
      'Imbalanced Data Handling',
      'Pandas & NumPy',
      'Cross-Validation & Metrics',
    ],
  },
  {
    key: 'recommender',
    title: 'Recommender Systems',
    description: 'Personalization engines, matrix factorization, and ranking algorithms.',
    icon: 'tabler:thumb-up',
    tags: [
      'Collaborative Filtering (UBCF / IBCF)',
      'Matrix Factorization',
      'Content-Based Filtering',
      'Hybrid Systems',
      'Learning to Rank (LTR)',
    ],
  },
  {
    key: 'software-infra',
    title: 'Software Engineering & Data Infrastructure',
    description: 'Production-ready backend services, API design, and data storage.',
    icon: 'tabler:server-cog',
    tags: [
      'Python (OOP)',
      'FastAPI',
      'RESTful APIs',
      'SQL (PostgreSQL, SQLite)',
      'Git & GitHub Actions',
      'Data Version Control (DVC)',
      'Linux / Bash',
    ],
  },
  {
    key: 'computer-vision',
    title: 'Computer Vision (Foundations)',
    description: 'Visual data preprocessing, neural vision pipelines, and OCR.',
    icon: 'tabler:eye',
    tags: [
      'OpenCV',
      'Convolutional Neural Networks (CNNs)',
      'Image Preprocessing & Augmentation',
      'OCR Pipelines',
      'PyTorch Vision',
    ],
  },
];
---

<Section id="skills" title="Skills" subtitle="Capability domains I work across — from research-grade modeling to production systems.">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {capabilities.map((capability) => (
      <article class="card p-6 group hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 hover:shadow-soft-lg hover:-translate-y-1">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 transition-transform duration-300 group-hover:scale-110">
            <Icon name={capability.icon} class="w-5 h-5" aria-hidden="true" />
          </span>
          <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-50 leading-snug">{capability.title}</h3>
        </div>
        <p class="text-sm text-surface-600 dark:text-surface-400 mb-4 leading-relaxed">{capability.description}</p>
        <ul class="flex flex-wrap gap-2" role="list" aria-label={`${capability.title} skills`}>
          {capability.tags.map((tag) => (
            <li
              class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-100/80 dark:bg-surface-800/80 border border-surface-200 dark:border-surface-700 text-surface-700 dark:text-surface-300"
              role="listitem"
            >
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</Section>
