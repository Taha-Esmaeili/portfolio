---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  skills: Array<{
    id: string;
    name: string;
    category: string;
    proficiency: number;
    yearsExperience: number;
    description?: string;
    icon?: string;
    relatedProjects?: string[];
  }>;
}

const { skills } = Astro.props;

const categories = [
  { key: 'ai', label: 'AI & NLP', icon: 'tabler:brain' },
  { key: 'data', label: 'Data Science', icon: 'tabler:chart-bar' },
  { key: 'languages', label: 'Languages', icon: 'tabler:code' },
  { key: 'backend', label: 'Databases', icon: 'tabler:database' },
  { key: 'tools', label: 'Tools', icon: 'tabler:tools' },
].filter((cat) => skills.some((s) => s.category === cat.key));

const categorySkills = (key: string) => skills.filter((s) => s.category === key);
---

<Section id="skills" title="Skills" subtitle="Technologies and tools I work with regularly, organized by category.">
  <div class="space-y-12 lg:space-y-16">
    {categories.map((cat, catIndex) => (
      <div class="animate-in" style={`animation-delay: ${catIndex * 100}ms`}>
        <div class="flex items-center gap-3 mb-6">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400">
            <Icon name={cat.icon} class="w-5 h-5" aria-hidden="true" />
          </span>
          <h3 class="text-xl font-semibold text-surface-900 dark:text-surface-50">{cat.label}</h3>
          <span class="ml-2 text-sm text-surface-400 dark:text-surface-500">{categorySkills(cat.key).length}</span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {categorySkills(cat.key).map((skill, skillIndex) => (
            <article
              class="card p-5 group hover:border-primary-300 dark:hover:border-primary-700 animate-in"
              style={`animation-delay: ${(catIndex * 100) + (skillIndex * 50)}ms`}
            >
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                  <Icon name={skill.icon || 'mdi:help-circle'} class="w-6 h-6 text-primary-600 dark:text-primary-400" aria-hidden="true" />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="font-medium text-surface-900 dark:text-surface-50 truncate">{skill.name}</h4>
                  {skill.description && (
                    <p class="text-xs text-surface-600 dark:text-surface-400 mt-0.5 leading-snug">{skill.description}</p>
                  )}
                  <div class="mt-2.5 flex items-center gap-3">
                    <div class="flex-1 h-2 bg-surface-100 dark:bg-surface-800 rounded-full overflow-hidden">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-primary-500 to-primary-400 transition-[width] duration-700 ease-out"
                        style="width: 0%"
                        data-proficiency={skill.proficiency * 20}
                        role="progressbar"
                        aria-valuenow={skill.proficiency * 20}
                        aria-valuemin={0}
                        aria-valuemax={100}
                        aria-label={`${skill.name} proficiency`}
                      />
                    </div>
                    <span class="text-xs font-mono text-surface-500 dark:text-surface-400 w-10 text-right tabular-nums">{skill.proficiency}/5</span>
                  </div>
                  <div class="mt-2 flex items-center gap-1.5 text-xs text-surface-500 dark:text-surface-400">
                    <Icon name="mdi:calendar" class="w-3.5 h-3.5" aria-hidden="true" />
                    <span>{skill.yearsExperience}+ yrs</span>
                    {skill.relatedProjects && skill.relatedProjects.length > 0 && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{skill.relatedProjects.length} project{skill.relatedProjects.length !== 1 ? 's' : ''}</span>
                      </>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bars = entry.target.querySelectorAll('[data-proficiency]');
          bars.forEach((bar, index) => {
            const proficiency = bar.getAttribute('data-proficiency');
            setTimeout(() => {
              (bar as HTMLElement).style.width = `${proficiency}%`;
            }, index * 100);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll('#skills article').forEach((el) => observer.observe(el));
</script>

<style>
  :host {
    display: block;
  }
</style>
