---
import Section from '../common/Section.astro';
import Badge from '../common/Badge.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';

interface Props {
  experiences: Array<{
    id: string;
    company: string;
    role: string;
    location: string;
    startDate: string;
    endDate?: string;
    current: boolean;
    achievements: string[];
    logo?: string;
    techStack?: string[];
  }>;
}

const { experiences } = Astro.props;

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<Section id="experience" title="Experience" subtitle="My professional journey building software at scale.">
  <ol class="relative m-0 list-none flex flex-col gap-5 p-0">
    {experiences.map((exp, index) => (
      <li class="relative flex gap-4 sm:gap-6 group animate-in" style={`animation-delay: ${index * 100}ms`}>
        <!-- Timeline rail: dot + connecting line -->
        <div class="flex flex-col items-center pt-1.5">
          <span
            class="relative z-10 flex-shrink-0 w-4 h-4 rounded-full bg-primary-500 ring-4 ring-surface-50 dark:ring-surface-950 transition-transform duration-300 group-hover:scale-125"
            aria-hidden="true"
          />
          {index < experiences.length - 1 && (
            <span class="w-0.5 flex-1 rounded-full bg-gradient-to-b from-surface-200 to-transparent dark:from-surface-700 dark:to-transparent mt-2" aria-hidden="true" />
          )}
        </div>

        <!-- Content -->
        <div class="flex-1 pb-0">
          <article class="card p-6 sm:p-8 transition-all duration-300 hover:shadow-soft-lg hover:-translate-y-1">
            <header class="flex items-start gap-4 mb-5">
              {exp.logo && (
                <Image
                  src={exp.logo}
                  alt={`${exp.company} logo`}
                  class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl object-contain bg-surface-100 dark:bg-surface-800 p-2 flex-shrink-0"
                  width={56}
                  height={56}
                />
              )}
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="text-lg sm:text-xl font-semibold text-surface-900 dark:text-surface-50">{exp.role}</h3>
                  {exp.current && (
                    <Badge variant="primary" size="sm" dot class="ml-1">Current</Badge>
                  )}
                </div>
                <p class="text-primary-600 dark:text-primary-400 font-medium">{exp.company}</p>
                <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">
                  {formatDate(exp.startDate)} – {exp.current ? 'Present' : formatDate(exp.endDate || '')}
                  <span aria-hidden="true"> · </span>
                  {exp.location}
                </p>
              </div>
            </header>

            <ul class="space-y-3" role="list">
              {exp.achievements.map((achievement) => (
                <li class="flex gap-3 text-surface-600 dark:text-surface-400 leading-relaxed">
                  <Icon name="tabler:check" class="w-5 h-5 flex-shrink-0 text-primary-500 dark:text-primary-400 mt-0.5" aria-hidden="true" />
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>

            {exp.techStack && exp.techStack.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2" aria-label="Technologies used">
                {exp.techStack.map((tech) => (
                  <span class="badge badge-secondary">{tech}</span>
                ))}
              </div>
            )}
          </article>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  :host {
    display: block;
  }
</style>
