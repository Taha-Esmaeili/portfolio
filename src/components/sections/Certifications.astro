---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';
import Badge from '../common/Badge.astro';

interface Props {
  certifications: Array<{
    id: string;
    title: string;
    issuer: string;
    date: string;
    url?: string;
  }>;
}

const { certifications } = Astro.props;

const sorted = [...certifications].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Section id="certifications" title="Certifications" subtitle="Professional courses and certifications in AI, ML, and data science.">
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {sorted.map((cert, index) => (
      <article class="card p-5 group animate-in hover:border-primary-300 dark:hover:border-primary-700" style={`animation-delay: ${index * 60}ms`}>
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400 flex items-center justify-center">
            <Icon name="tabler:certificate" class="w-5 h-5" aria-hidden="true" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-medium text-surface-900 dark:text-surface-50 leading-snug">{cert.title}</h3>
              {cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-shrink-0 text-surface-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                  aria-label={`Open ${cert.title} certificate`}
                >
                  <Icon name="tabler:external-link" class="w-4 h-4" aria-hidden="true" />
                </a>
              )}
            </div>
            <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{cert.issuer}</p>
            <p class="text-xs font-mono text-surface-400 dark:text-surface-500 mt-2">{cert.date}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  :host {
    display: block;
  }
</style>
