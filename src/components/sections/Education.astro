---
import Section from '../common/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  education: Array<{
    id: string;
    degree: string;
    school: string;
    schoolUrl?: string;
    location: string;
    startDate: string;
    endDate: string;
    description?: string;
  }>;
  languages?: Array<{ name: string; level: string }>;
}

const { education, languages = [] } = Astro.props;
---

<Section id="education" title="Education" subtitle="My academic background and the languages I work in.">
  <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
    <div class="lg:col-span-2 space-y-6">
      {education.map((edu, index) => (
        <article class="card p-6 sm:p-8 animate-in" style={`animation-delay: ${index * 100}ms`}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400 flex items-center justify-center">
              <Icon name="tabler:school" class="w-6 h-6" aria-hidden="true" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-lg sm:text-xl font-semibold text-surface-900 dark:text-surface-50">{edu.degree}</h3>
                  {edu.schoolUrl ? (
                    <a
                      href={edu.schoolUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary-600 dark:text-primary-400 font-medium hover:underline"
                    >
                      {edu.school}
                    </a>
                  ) : (
                    <p class="text-primary-600 dark:text-primary-400 font-medium">{edu.school}</p>
                  )}
                </div>
                <span class="text-sm font-mono text-surface-500 dark:text-surface-400 whitespace-nowrap">
                  {edu.startDate} – {edu.endDate}
                </span>
              </div>
              <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{edu.location}</p>
              {edu.description && (
                <p class="mt-4 text-surface-600 dark:text-surface-400 leading-relaxed">{edu.description}</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {languages.length > 0 && (
      <aside class="animate-in delay-200">
        <div class="card p-6 lg:sticky lg:top-24">
          <div class="flex items-center gap-3 mb-5">
            <Icon name="tabler:language" class="w-5 h-5 text-primary-600 dark:text-primary-400" aria-hidden="true" />
            <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-50">Languages</h3>
          </div>
          <ul class="space-y-4" role="list">
            {languages.map((lang) => (
              <li class="flex items-center justify-between gap-4">
                <span class="font-medium text-surface-900 dark:text-surface-50">{lang.name}</span>
                <span class="badge badge-secondary">{lang.level}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Section>

<style>
  :host {
    display: block;
  }
</style>
