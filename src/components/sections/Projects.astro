---
import Section from '../common/Section.astro';
import Button from '../common/Button.astro';
import Badge from '../common/Badge.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';

interface Props {
  projects: Array<{
    id: string;
    title: string;
    description: string;
    shortDescription: string;
    image: string;
    techStack: string[];
    liveUrl?: string;
    codeUrl?: string;
    featured: boolean;
    category: string;
  }>;
}

const { projects } = Astro.props;

const categories = ['all', 'featured', ...new Set(projects.map(p => p.category))];
---

<Section id="projects" title="Projects">
  <div class="mb-10">
    <div class="flex flex-wrap gap-2 justify-center" role="tablist" aria-label="Project categories">
      {categories.map((cat) => (
        <button
          role="tab"
          aria-selected={cat === 'all'}
          aria-controls={`panel-${cat}`}
          id={`tab-${cat}`}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 ${cat === 'all' ? 'bg-primary-600 text-white' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-700'}`}
          data-category={cat}
        >
          {cat.charAt(0).toUpperCase() + cat.slice(1)}
        </button>
      ))}
    </div>
  </div>
  
  {categories.map((cat) => {
    const filtered = cat === 'all' ? projects : cat === 'featured' ? projects.filter(p => p.featured) : projects.filter(p => p.category === cat);
    if (filtered.length === 0) return '';
    return (
      <div role="tabpanel" id={`panel-${cat}`} aria-labelledby={`tab-${cat}`} class={cat === 'all' ? '' : 'hidden'}>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {filtered.map((project, index) => (
            <article class="card group animate-in" style={`animation-delay: ${index * 100}ms`}>
              <div class="relative aspect-video overflow-hidden">
                <Image
                  src={project.image}
                  alt={`${project.title} screenshot`}
                  class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  width={800}
                  height={450}
                />
                {project.featured && (
                  <span class="absolute top-3 left-3 badge badge-primary">Featured</span>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-surface-900 dark:text-surface-50 mb-2">{project.title}</h3>
                <p class="text-surface-600 dark:text-surface-400 text-sm mb-4 line-clamp-2">{project.shortDescription}</p>
                <div class="flex flex-wrap gap-2 mb-4" aria-label="Technologies">
                  {project.techStack.slice(0, 5).map((tech) => (
                    <span class="badge badge-secondary">{tech}</span>
                  ))}
                  {project.techStack.length > 5 && (
                    <span class="badge badge-secondary">+{project.techStack.length - 5} more</span>
                  )}
                </div>
                <div class="flex gap-3">
                  {project.liveUrl && (
                    <Button href={project.liveUrl} variant="primary" size="sm" target="_blank" rel="noopener noreferrer">
                      <Icon name="tabler:external-link" class="w-4 h-4" aria-hidden="true" />
                      Live Demo
                    </Button>
                  )}
                  {project.codeUrl && (
                    <Button href={project.codeUrl} variant="secondary" size="sm" target="_blank" rel="noopener noreferrer">
                      <Icon name="logos:github-icon" class="w-4 h-4" aria-hidden="true" />
                      Source Code
                    </Button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    );
  })}
  
  {projects.length === 0 && (
    <div class="text-center py-16">
      <Icon name="mdi:folder-outline" class="w-16 h-16 mx-auto text-surface-300 dark:text-surface-600 mb-4" aria-hidden="true" />
      <h3 class="text-xl font-medium text-surface-900 dark:text-surface-50 mb-2">No projects yet</h3>
      <p class="text-surface-600 dark:text-surface-400">Projects will appear here once added.</p>
    </div>
  )}
</Section>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');
  
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const category = tab.getAttribute('data-category');
      
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('bg-primary-600', 'text-white');
        t.classList.add('bg-surface-100', 'text-surface-700', 'dark:bg-surface-800', 'dark:text-surface-300');
      });
      
      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('bg-primary-600', 'text-white');
      tab.classList.remove('bg-surface-100', 'text-surface-700', 'dark:bg-surface-800', 'dark:text-surface-300');
      
      panels.forEach((panel) => {
        panel.classList.add('hidden');
      });
      
      const activePanel = document.getElementById(`panel-${category}`);
      if (activePanel) activePanel.classList.remove('hidden');
    });
    
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const index = Array.from(tabs).indexOf(tab);
        const nextIndex = e.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        if (nextTab) {
          nextTab.click();
          nextTab.focus();
        }
      }
    });
  });
</script>

<style>
  :host {
    display: block;
  }
</style>